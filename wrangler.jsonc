{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spotitheque",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // L'interface React est une SPA : toute navigation inconnue renvoie index.html.
    "not_found_handling": "single-page-application",
    // Les routes /api/* (dont la redirection OAuth) passent toujours par le Worker.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spotitheque",
      "database_id": "c9e2b347-08d9-40ca-937e-8d23e3308801",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Client ID de l'app Spotify (non secret). Le Client Secret est un secret Wrangler.
    "SPOTIFY_CLIENT_ID": "0a933ff40fa84b7f87c2a8e0ecbc19db"
  },
  "observability": {
    "enabled": true
  }
}
