{
  "name": "spotitheque",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "wrangler d1 migrations apply spotitheque --remote && npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply spotitheque --local",
    "db:seed": "node scripts/gen-seed.mjs > .wrangler/seed.sql && wrangler d1 execute spotitheque --local --file .wrangler/seed.sql",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
